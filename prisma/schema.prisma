generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"
  url = env("DATABASE_URL") }
enum Role { SUPER_ADMIN ADMIN WARDEN STUDENT MAINTENANCE MESS }
enum CStatus { NEW ASSIGNED IN_PROGRESS WAITING RESOLVED CLOSED }
enum FStatus { PENDING PAID }
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role
  gender String?
  code String? @unique
  hostelId String?
  createdAt DateTime @default(now())
  deletedAt DateTime?
  allocations Allocation[] @relation("student")
  fees Fee[]
  complaints Complaint[] @relation("filer")
  assigned Complaint[] @relation("assignee")
  notifications Notification[]
}
model Hostel { id String @id @default(cuid())
  name String @unique
  type String
  rooms Room[] }
model Room {
  id String @id @default(cuid())
  hostelId String
  hostel Hostel @relation(fields: [hostelId], references: [id])
  floor Int
  number String
  capacity Int @default(4)
  maintenance Boolean @default(false)
  monthlyFee Int
  beds Bed[]
  @@unique([hostelId, number])
}
model Bed { id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id])
  label String
  allocations Allocation[]
  @@unique([roomId, label]) }
model Allocation {
  id String @id @default(cuid())
  bedId String
  bed Bed @relation(fields: [bedId], references: [id])
  studentId String
  student User @relation("student", fields: [studentId], references: [id])
  startedAt DateTime @default(now())
  endedAt DateTime?
  byId String?
  @@index([studentId])
  @@index([bedId])
}
model Fee {
  id String @id @default(cuid())
  studentId String
  student User @relation(fields: [studentId], references: [id])
  title String
  amount Int
  dueDate DateTime
  status FStatus @default(PENDING)
  orderId String? @unique
  paidAt DateTime?
  events PaymentEvent[]
  @@index([studentId, status])
}
model PaymentEvent { id String @id @default(cuid())
  eventId String @unique
  feeId String
  fee Fee @relation(fields: [feeId], references: [id])
  type String
  createdAt DateTime @default(now()) }
model Complaint {
  id String @id @default(cuid())
  ticket Int @unique @default(autoincrement())
  studentId String
  student User @relation("filer", fields: [studentId], references: [id])
  category String
  priority String @default("MEDIUM")
  description String
  status CStatus @default(NEW)
  assigneeId String?
  assignee User? @relation("assignee", fields: [assigneeId], references: [id])
  rating Int?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([status])
  @@index([studentId])
}
model Notification { id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt]) }
model AuditLog { id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String?
  meta Json?
  createdAt DateTime @default(now())
  @@index([createdAt]) }
